# Copy this to .env and fill in real values. Never commit .env itself.

# Required for anything that calls Claude (researcher, writer, classifier, reporter)
ANTHROPIC_API_KEY=sk-ant-xxx

# Or use Groq for testing (free llama models)
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

# Required only once you wire up the database (prospects.py routes, scheduler)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required only for real sending (agent/tools/sender.py)
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Required only for the reply monitor (agent/tools/inbox_reader.py)
IMAP_HOST=imap.gmail.com
IMAP_USER=outreach@yourdomain.com
IMAP_PASS=

# Required only for email verification gate (agent/tools/email_verifier.py)
BOUNCER_API_KEY=

# Required only for the Calendly webhook (api/routes/webhooks.py)
CALENDLY_API_KEY=
CALENDLY_SCHEDULING_LINK=https://calendly.com/you/intro-call

# Optional overrides
MODEL_CHEAP=claude-haiku-4-5
MODEL_WRITER=claude-sonnet-4-5
MAX_EMAILS_PER_DOMAIN_PER_DAY=50
